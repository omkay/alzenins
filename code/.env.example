# Copy to .env.local for local development.
# The port is 5433, not 5432 — it deliberately avoids clashing with any
# Postgres you already run locally. See docker-compose.yml at the repo root.
DATABASE_URL="postgresql://alzenins:alzenins@localhost:5433/alzenins"
APP_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-32-byte-random-string"

# AUTH_URL is NOT listed here on purpose: src/env.ts derives it from APP_URL.
# Auth.js builds absolute redirect URLs from it and otherwise falls back to the
# container bind address — staging redirected sign-in to https://0.0.0.0:8080
# until this was fixed. Set it explicitly only to override APP_URL.

# Optional. Omit both and the Google button is hidden.
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Optional in dev — without it, sign-in codes print to the server log.
RESEND_API_KEY=""
EMAIL_FROM="Alzenins <noreply@alzenins.com>"

# Mamo Business API key. Never commit a real value.
# MAMOPAY_ENV switches the base URL between the sandbox and production.
MAMOPAY_API_KEY=""
MAMOPAY_ENV="sandbox"

# Observability. All optional — absent keys disable the integration entirely.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST="https://eu.i.posthog.com"
